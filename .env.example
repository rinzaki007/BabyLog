# Generate a private random secret (at least 32 characters); keep it stable across upgrades.
BABYLOG_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# NAS host port and persistent host-side data directory.
BABYLOG_PORT=18765
BABYLOG_DATA_PATH=./data

# Access-token lifetime and maximum size of a single uploaded photo.
BABYLOG_TOKEN_TTL_SECONDS=2592000
BABYLOG_MAX_PHOTO_BYTES=20971520

# Exact IP address(es) of reverse proxies that connect directly to BabyLog.
# Keep the default for local-only access; set the actual peer IP for your proxy.
# Multiple IPs may be comma-separated. Never use *.
BABYLOG_TRUSTED_PROXY_IPS=127.0.0.1

# NAS-side GitHub release check interval in seconds.
BABYLOG_UPDATE_CHECK_SECONDS=900
